{
  "$schema": "https://raw.githubusercontent.com/nicovince/tauri/refs/heads/dev/crates/tauri-cli/schema.json",
  "productName": "ChirpTime",
  "version": "1.0.0",
  "identifier": "com.chirptime.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:7460",
    "beforeDevCommand": "bun run vite:dev",
    "beforeBuildCommand": "bun run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChirpTime",
        "width": 320,
        "height": 540,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {}
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "ChirpTime",
    "category": "Productivity",
    "shortDescription": "Background life recorder for Windows",
    "longDescription": "ChirpTime records your screens, webcam, microphone and system audio continuously so you can watch a day back. It also takes a periodic screenshot and short clip on an interval. Requires FFmpeg on PATH.",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
